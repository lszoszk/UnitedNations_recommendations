# /etc/cron.d/uhri-precompute
# UHRI dashboard scheduled jobs. Runs as amuvmuser.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# Every 15 min — keep the precomputed zero-filter cache warm
*/15 * * * * amuvmuser /opt/uhri/precompute.sh >> /var/log/uhri-precompute.log 2>&1

# 1st of the month at 03:00 UTC — full data refresh:
#   * pull new records from OHCHR API
#   * run Stage 1-3 pipeline on the merged dataset
#   * rebuild SQLite + FTS5 + precompute
#   * email summary
0 3 1 * * amuvmuser /opt/uhri/refresh_monthly.sh >> /var/log/uhri-monthly.log 2>&1
