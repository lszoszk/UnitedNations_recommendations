{
  "name": "uhri-plus-dashboard",
  "version": "1.0.0",
  "description": "UHRI+ static dashboard for searching and analysing cleaned UN human-rights recommendations.",
  "private": true,
  "scripts": {
    "test":               "playwright test --project=chromium",
    "test:headed":        "playwright test --headed --project=chromium",
    "test:ui":            "playwright test --ui",
    "test:firefox":       "playwright test --project=firefox",
    "test:webkit":        "playwright test --project=webkit",
    "test:mobile":        "playwright test --project=mobile",
    "test:cross-browser": "playwright test",
    "test:contracts":     "playwright test --config=playwright.contracts.config.ts",
    "test:live-flows":    "playwright test --config=playwright.live.config.ts",
    "test:self-audit":    "playwright test --config=playwright.audit.config.ts",
    "serve":              "python3 -m http.server 8787",
    "sync-counts":        "node scripts/update-counts.mjs",
    "sync-counts:dry":    "node scripts/update-counts.mjs --dry"
  },
  "apiSchemaVersion": "v1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lszoszk/UnitedNations_recommendations.git"
  },
  "homepage": "https://lszoszk.github.io/UnitedNations_recommendations/",
  "author": "L. Szoszkiewicz",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.59.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
